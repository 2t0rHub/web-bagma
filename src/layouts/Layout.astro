---
// Layout.astro
// Este layout envuelve tus páginas y permite insertar un header, main y footer
// Puedes pasar contenido con <slot />
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <meta name="generator" content={Astro.generator} />
    <title>Grupo Bagma & R</title>
  </head>
  <body class="bg-background text-foreground">
    <!-- Header: puedes usar un componente React aquí con client:load -->
    <header>
      <slot name="header" />
    </header>

    <!-- Main content -->
    <main class="min-h-screen">
      <slot />
    </main>
  </body>
</html>
